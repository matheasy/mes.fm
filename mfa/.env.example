# The wallet this dashboard tracks. Defaults to the original wallet in code if unset;
# override to reuse this app for a different address.
WALLET_ADDRESS=0xaeF8A5Ab45652Bc612B2cE72B0631C9E052404A5

# NodeReal MegaNode API key (dashboard.nodereal.io, free tier). Used for native + BEP-20
# balances and transaction history on BSC via plain JSON-RPC (eth_getBalance +
# nr_getAssetTransfers). This app previously used Moralis, but Moralis's free BSC tier
# ended (usage now requires a paid plan) - NodeReal's BSCTrace is BNB Chain's own endorsed
# free replacement, same provider the mes.fm/ai and mes.fm/sov trackers already use.
NODEREAL_API_KEY=

# Optional. CoinGecko free "Demo" API key (coingecko.com/en/api/pricing). Works without one
# at low request volume, but a key raises your rate limit. Used for the native coin's and
# every BEP-20 token's current + historical USD pricing (needed by the cost-basis engine) -
# NodeReal doesn't attach live pricing to balances/transfers the way Moralis did.
COINGECKO_API_KEY=

# Upstash Redis (or the Vercel KV integration, which sets the same variable names) - backs
# the server-side response cache so the manual refresh button and NodeReal/CoinGecko rate
# limits behave in production. Local dev works without these; caching is just skipped.
KV_REST_API_URL=
KV_REST_API_TOKEN=
