# MES Store of Value tracks three fixed holdings from three hardcoded addresses (see
# src/lib/config.ts's ADDRESSES) - there is no WALLET_ADDRESS override here.

# --- Bitcoin source (BTCB on BNB Chain + WBTC on Polygon + WBTC on Ethereum, combined) ---

# NodeReal MegaNode API key (dashboard.nodereal.io, free tier). Used for BTCB balance + transfer
# history on BNB Chain via nr_getAssetTransfers. Same provider/caveats as the ai/ tracker's BSC
# support - BNB Chain has no free tier on Etherscan's V2 API, so NodeReal is the free option.
NODEREAL_API_KEY=

# Etherscan API key (etherscan.io/apis, free tier). ONE key covers Ethereum Mainnet (chainid 1)
# AND Polygon (chainid 137) via the V2 `chainid` param. Used for WBTC transfer history on both.
# Free tier is one shared budget across both chains.
ETHERSCAN_API_KEY=

# --- Pricing ---

# CoinGecko free "Demo" API key (coingecko.com/en/api/pricing). Optional but raises the rate
# limit. Prices BTC (`bitcoin`), XRP (`ripple`), and HIVE (`hive`, used to value TGLD) - current
# and historical (day granularity).
COINGECKO_API_KEY=

# --- XRP source (no key) ---

# XRP Ledger JSON-RPC endpoint. Defaults to the keyless community cluster; override if it's
# rate-limiting or missing history.
# XRPL_RPC_URL=https://xrplcluster.com/

# --- TGLD source (no key) ---

# Hive Engine contract-RPC node and per-account history node. Both keyless; override only if the
# defaults are down.
# HIVE_ENGINE_RPC_URL=https://api.hive-engine.com/rpc
# HIVE_ENGINE_HISTORY_URL=https://history.hive-engine.com

# --- Caching ---

# Upstash Redis (or the Vercel KV integration, which sets the same variable names) - backs the
# server-side response cache so the manual Refresh button and every upstream API's rate limits
# behave in production. Local dev works without these; caching is just skipped.
KV_REST_API_URL=
KV_REST_API_TOKEN=
