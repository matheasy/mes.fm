{
  "manifest_version": 3,
  "name": "MES Archive",
  "version": "1.2.0",
  "description": "One click archives the page you are on: opens the Wayback Machine, archive.today, Ghostarchive and any archive sites you choose, and can hand the page to ArcHive for the Hive blockchain. Free, private. By MES (mes.fm).",
  "homepage_url": "https://mes.fm/archive",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Archive this page",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "scripting",
    "webRequest"
  ],
  "commands": {
    "archive-page": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Archive this page on the sites you chose"
    }
  },
  "host_permissions": [
    "https://dhenz14.github.io/*",
    "https://archive.ph/*",
    "https://archive.is/*",
    "https://archive.today/*",
    "https://archive.md/*",
    "https://archive.vn/*",
    "https://archive.li/*",
    "https://archive.fo/*"
  ]
}
