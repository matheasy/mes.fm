{
  "manifest_version": 3,
  "name": "MES Read Aloud",
  "version": "1.5.2",
  "description": "Reads any web page or selected text aloud and highlights the word and sentence being read. Free, private, no tracking. By MES (mes.fm).",
  "homepage_url": "https://mes.fm/read-aloud",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "MES Read Aloud",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "commands": {
    "toggle": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Read the selection or page aloud / pause / resume"
    }
  }
}
