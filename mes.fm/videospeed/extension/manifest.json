{
  "manifest_version": 3,
  "name": "MES Video Speed Controller",
  "version": "1.1.0",
  "description": "Speed up or slow down any HTML5 video or audio with keyboard shortcuts and an on-video control. Free, private, no tracking. By MES (mes.fm).",
  "homepage_url": "https://mes.fm/videospeed",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "MES Video Speed Controller",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "permissions": ["storage", "activeTab"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared.js", "content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ]
}
