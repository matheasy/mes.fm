{
  "manifest_version": 3,
  "name": "MES AI Helper",
  "version": "1.0.0",
  "description": "Lets MES AI (mes.fm/ai) open tabs, read pages, click and type in your browser for a task you give it. It asks before sending or paying.",
  "homepage_url": "https://mes.fm/ai#browser",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "MES AI Helper", "default_popup": "popup.html", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["tabs", "scripting", "storage", "tabGroups"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["https://mes.fm/ai", "https://mes.fm/ai?*", "https://mes.fm/ai#*", "https://mes.fm/ai/*", "https://mes.fm/ai-*", "http://127.0.0.1/*", "http://localhost/*"],
      "exclude_matches": ["https://mes.fm/ai-trading*", "https://mes.fm/ai-detector*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
