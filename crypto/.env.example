# This app has no wallet/API keys of its own - it's a pure aggregator that fetches already-
# computed data from the ai/, mfa/, and sov/ trackers' own production APIs and combines it.
# Override these only if those deployments move; all default to the URLs already wired into
# ../mes.fm/vercel.json's rewrites.
AI_SOURCE_URL=https://mes-fm-ai.vercel.app/ai
MFA_SOURCE_URL=https://mes-fm-mfa.vercel.app/mfa
SOV_SOURCE_URL=https://mes-fm-sov.vercel.app/sov

# Needed for the Taxes page (mes.fm/taxes): Upstash Redis, same account as ai/mfa/sov already use.
# Without these, CAD rates are re-fetched from the Bank of Canada on every request instead of
# cached, and labels/notes/screenshot links (lib/labels.ts) are accepted but never persisted -
# fine for local dev, not for production.
KV_REST_API_URL=
KV_REST_API_TOKEN=
