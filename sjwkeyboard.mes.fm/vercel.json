{
  "ignoreCommand": "[ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- ./",
  "redirects": [
    { "source": "/", "destination": "https://mes.fm/sjwkeyboard", "permanent": true },
    { "source": "/(.*)", "destination": "https://mes.fm/sjwkeyboard/$1", "permanent": true }
  ]
}
