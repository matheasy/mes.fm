{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(iphone|ipod|android.*mobile|windows phone|blackberry|bb10|opera mini|iemobile).*"
        }
      ],
      "destination": "/m/index"
    },
    {
      "source": "/:page(contact-8|food-beverage|hotels-airbnbs|investment|product-branding|video)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(iphone|ipod|android.*mobile|windows phone|blackberry|bb10|opera mini|iemobile).*"
        }
      ],
      "destination": "/m/:page"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Vary",
          "value": "User-Agent"
        }
      ]
    },
    {
      "source": "/:page(contact-8|food-beverage|hotels-airbnbs|investment|product-branding|video)",
      "headers": [
        {
          "key": "Vary",
          "value": "User-Agent"
        }
      ]
    },
    {
      "source": "/(media|fonts|video|assets/css)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
