{
  "ignoreCommand": "if [ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && git cat-file -e \"$VERCEL_GIT_PREVIOUS_SHA^{commit}\" 2>/dev/null && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- ./; then exit 0; else exit 1; fi",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "karo.mes.fm"
        }
      ],
      "destination": "https://www.alpinewestcreative.com/$1",
      "permanent": true
    },
    {
      "source": "/work/:path*",
      "destination": "/hotels-airbnbs",
      "permanent": false
    },
    {
      "source": "/work",
      "destination": "/hotels-airbnbs",
      "permanent": false
    },
    {
      "source": "/services",
      "destination": "/investment",
      "permanent": false
    },
    {
      "source": "/inquire",
      "destination": "/contact-8",
      "permanent": false
    },
    {
      "source": "/contact",
      "destination": "/contact-8",
      "permanent": false
    },
    {
      "source": "/about",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/travel-collaborations",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/portfolio",
      "destination": "/hotels-airbnbs",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(iphone|ipod|android.*mobile|windows phone|blackberry|bb10|opera mini|iemobile).*"
        }
      ],
      "missing": [
        {
          "type": "cookie",
          "key": "karo_layout",
          "value": "desktop"
        },
        {
          "type": "cookie",
          "key": "karo_wide",
          "value": "1"
        }
      ],
      "destination": "/m",
      "permanent": false
    },
    {
      "source": "/:page(contact-8|food-beverage|hotels-airbnbs|investment|product-branding|video)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(iphone|ipod|android.*mobile|windows phone|blackberry|bb10|opera mini|iemobile).*"
        }
      ],
      "missing": [
        {
          "type": "cookie",
          "key": "karo_layout",
          "value": "desktop"
        },
        {
          "type": "cookie",
          "key": "karo_wide",
          "value": "1"
        }
      ],
      "destination": "/m/:page",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "karo.mes.fm"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/((?!media/|fonts/|video/|assets/).*)",
      "headers": [
        {
          "key": "Vary",
          "value": "User-Agent"
        }
      ]
    },
    {
      "source": "/(media|fonts|video|assets/css)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(stats|search-console|seo|awc/.*|api/awc/.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/p",
      "destination": "https://mes.fm/api/awc/p"
    },
    {
      "source": "/stats",
      "destination": "https://mes.fm/awc/stats"
    },
    {
      "source": "/search-console",
      "destination": "https://mes.fm/awc/search-console"
    },
    {
      "source": "/seo",
      "destination": "https://mes.fm/awc/seo"
    },
    {
      "source": "/awc/:path*",
      "destination": "https://mes.fm/awc/:path*"
    },
    {
      "source": "/api/awc/:path*",
      "destination": "https://mes.fm/api/awc/:path*"
    }
  ]
}
