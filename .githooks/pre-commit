#!/bin/sh
# Keeps mes.fm/newest.json (the "Newest calculators / tools" strip on the homepage, /calculators and /tools) current:
# whenever a commit touches a hub's cards or adds a page, regenerate it and include it in the same commit.
# Enabled with: git config core.hooksPath .githooks   (the repo has no CI; see build_newest.py)
# (2026-10-30: the cd used to be joined to the next `if` with `||`, so the if only ran when cd FAILED and newest.json
# was never regenerated by this hook.)
cd "$(git rev-parse --show-toplevel)" || exit 0
if git diff --cached --name-only | grep -qE '^mes\.fm/(tools|calculators)\.html$' || git diff --cached --name-only --diff-filter=A | grep -qE '^mes\.fm/[^/]+/index\.html$'; then
  python3 build_newest.py --apply >/dev/null 2>&1 && git add mes.fm/newest.json
fi
# mes.fm/hub-meta.json (added / updated dates + type for the List / Table views of /calculators and /tools, see
# build_hub_meta.py): only when the commit touches something under mes.fm/ that is not the json itself. The script counts
# the staged files as a commit made today and only writes when a date changes, so most commits leave it alone.
if git diff --cached --name-only | grep -E '^mes\.fm/' | grep -qvE '^mes\.fm/hub-meta\.json$'; then
  python3 build_hub_meta.py --apply >/dev/null 2>&1 && git add mes.fm/hub-meta.json
fi
# mes.fm/reminder/upcoming.json (the Reminder page's "Next MES stream"): read from the pre-stream pages' own reminder links,
# so adding or editing a math-qa-* / livestream-* page is all it takes (see build_upcoming_streams.py)
if git diff --cached --name-only | grep -qE '^mes\.fm/(math-qa|livestream)-[^/]+/index\.html$'; then
  python3 build_upcoming_streams.py --apply >/dev/null 2>&1 && git add mes.fm/reminder/upcoming.json
fi
exit 0
