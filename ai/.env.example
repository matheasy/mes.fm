# The wallet this dashboard tracks. Defaults to the original wallet in code if unset;
# override to reuse this app for a different address.
WALLET_ADDRESS=0x89aC35e57216A51Cf08f1c14B3Ce19D6813ee492

# Moralis Web3 Data API key (moralis.com, free tier: 40k compute units/day). Used for
# native + BEP-20 balances and decoded wallet transaction history on BSC. BscScan/Etherscan's
# API now requires a paid plan for BNB Chain, so this app uses Moralis instead. Compute units
# pool per Moralis ACCOUNT, not per key or per app - reusing the same key as the mes.fm/mfa
# tracker shares one 40k/day budget across both wallets; sign up with a different email for an
# independent quota if that becomes a problem.
MORALIS_API_KEY=

# Optional. CoinGecko free "Demo" API key (coingecko.com/en/api/pricing). Works without one
# at low request volume, but a key raises your rate limit. Used for the native coin's current
# price and for historical prices (needed by the cost-basis engine) - current BEP-20 prices
# come from Moralis directly.
COINGECKO_API_KEY=

# Upstash Redis (or the Vercel KV integration, which sets the same variable names) - backs
# the server-side response cache so the manual refresh button and Moralis/CoinGecko rate
# limits behave in production. Local dev works without these; caching is just skipped.
KV_REST_API_URL=
KV_REST_API_TOKEN=
